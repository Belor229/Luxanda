# Database Configuration (Prisma/Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# JWT Configuration
JWT_SECRET=changeme-very-secret

# Admin Configuration
ADMIN_PASSWORD=

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Email Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payment Configuration (Kkiapay only)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SANDBOX=true

# CinetPay Configuration (Future)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# Service Client
SERVICE_PHONE=
SERVICE_EMAIL=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key  # Pour les opérations admin côté serveur

# Direct Database URL (pour Prisma)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
