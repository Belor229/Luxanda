# Luxanda - Environment Variables Template
# Required for and Supabase SSR integration

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role (Server Side Only - DO NOT EXPOSE)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments (Optional if using for Subscriptions)
KKIAPAY_PUBLIC_KEY=your-kkiapay-public-key
KKIAPAY_PRIVATE_KEY=your-kkiapay-private-key
KKIAPAY_SECRET=your-kkiapay-secret

# Support
NEXT_PUBLIC_WHATSAPP_NUMBER=229XXXXXXXX
SUPPORT_EMAIL=contact@luxanda.bj

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
